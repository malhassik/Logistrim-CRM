# Виртуальное окружение (весит много, у каждого разработчика свое)
venv/
myenv/
env/

# Скомпилированные файлы Python (создаются автоматически)
__pycache__/
*.pyc
*.pyo
*.pyd

# База данных (локальная, с твоими тестовыми данными и паролями)
db.sqlite3

# Загруженные файлы (ТНки, чеки - личные данные компании)
media/

# Переменные окружения (секретные ключи и пароли, если будешь использовать)
.env

# Настройки редактора VS Code
.vscode/

# Системный мусор (создается Windows/Mac автоматически)
.DS_Store
Thumbs.db
staticfiles/